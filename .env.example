# Copy this file to .env and fill in the values. Never commit the real .env.

# Required. API key of the OpenAI-compatible provider (or proxy) you use.
OPENAI_API_KEY=your_api_key_here

# Required. Base URL of the OpenAI-compatible endpoint, including the version path.
# Examples: https://api.openai.com/v1  |  http://localhost:4000/v1 (LiteLLM proxy)
OPENAI_BASE_URL=https://api.openai.com/v1

# Required. A model ID offered by the configured provider.
OPENAI_MODEL=your-provider-model-id